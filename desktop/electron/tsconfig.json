{
  "compilerOptions": {
    "target": "es2023",
    "module": "commonjs",
    "lib": ["es2023", "dom"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["*.ts"]
}
